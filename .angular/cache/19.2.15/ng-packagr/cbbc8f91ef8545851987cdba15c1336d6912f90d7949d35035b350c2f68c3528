294,"value":"<div class=\"ng-moringa-table\" [class.collapsed]=\"isCollapsed\" [ngClass]=\"variant\">\r\n  <div class=\"moringa-header\" *ngIf=\"moringaHeader\">\r\n    <!-- Header and Tabs -->\r\n    <div class=\"moringa-container\">\r\n      <div class=\"moringa-group gap\">\r\n        <h6 class=\"table-title\">\r\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" class=\"bi bi-grid\"\r\n            viewBox=\"0 0 16 16\">\r\n            <path d=\"M1 2.5A1.5...\" />\r\n          </svg>\r\n          {{ title }}\r\n          <span class=\"text-muted\">{{ sub }}</span>\r\n        </h6>\r\n\r\n        <ng-container *ngIf=\"filterStyle?.includes('tabs') && searchOptions?.length\">\r\n          <ul class=\"nav moringa-tabs\" id=\"myTab\" role=\"tablist\">\r\n            <li class=\"nav-item\" role=\"presentation\">\r\n              <button class=\"nav-link\" [ngClass]=\"{ active: selectedOption === '' }\" (click)=\"selectTabOption('')\"\r\n                type=\"button\" role=\"tab\">All</button>\r\n            </li>\r\n            <li class=\"nav-item\" role=\"presentation\" *ngFor=\"let option of searchOptions\">\r\n              <button class=\"nav-link\" [ngClass]=\"{ active: selectedOption === option }\"\r\n                (click)=\"selectTabOption(option)\" type=\"button\" role=\"tab\">\r\n                <span class=\"moringa-badge\" [ngClass]=\"getStatusStyles(option)?.tagClass || 'tag-default'\">\r\n                  {{ getTabCount(option) }}\r\n                </span>\r\n                {{ option }}\r\n              </button>\r\n            </li>\r\n          </ul>\r\n        </ng-container>\r\n      </div>\r\n\r\n      <!-- Search / Filters -->\r\n      <div class=\"moringa-group gap\">\r\n        <ng-content select=\"[header-component]\"></ng-content>\r\n        <div class=\"moringa-group gap\">\r\n          <div class=\"moringa-btn-group\">\r\n            <ng-container *ngIf=\"filterStyle?.includes('dropdown') && searchOptions?.length\">\r\n              <select class=\"moringa-select\" [(ngModel)]=\"selectedOption\" (change)=\"applyFilters()\">\r\n                <option value=\"\">All</option>\r\n                <option *ngFor=\"let option of searchOptions\" [value]=\"option\">{{ option }}</option>\r\n              </select>\r\n            </ng-container>\r\n            <input type=\"text\" class=\"moringa-input\" placeholder=\"Search...\" *ngIf=\"filterStyle?.includes('keyword')\"\r\n              [(ngModel)]=\"searchKeyword\" (ngModelChange)=\"onSearchKeywordChange($event)\" />\r\n\r\n            <button class=\"moringa-btn\" *ngIf=\"filterStyle?.includes('date')\" (click)=\"toggleCalendar()\"\r\n              style=\"min-width: 120px;\">\r\n              <svg fill=\"currentColor\" class=\"bi bi-calendar\" viewBox=\"0 0 16 16\" width=\"16\" height=\"16\">\r\n                <path d=\"M3.5 0a.5...\" />\r\n              </svg>\r\n              <span>{{ selectedDate | date: 'y, MMMM, d' }}</span>\r\n            </button>\r\n\r\n            <div class=\"date-picker\" *ngIf=\"datePicker\" style=\"min-width: 350px;\">\r\n              <div class=\"moringa-btn-group align-justify\">\r\n                <select class=\"moringa-select\" [(ngModel)]=\"selectedMonth\" (change)=\"onMonthOrYearChange()\">\r\n                  <option *ngFor=\"let m of months; let i = index\" [value]=\"i\">{{ m }}</option>\r\n                </select>\r\n                <select class=\"moringa-select\" [(ngModel)]=\"selectedYear\" (change)=\"onMonthOrYearChange()\">\r\n                  <option *ngFor=\"let y of years\" [value]=\"y\">{{ y }}</option>\r\n                </select>\r\n              </div>\r\n              <div class=\"d-grid\" style=\"grid-template-columns: repeat(7, 1fr); gap: 4px;\">\r\n                <div class=\"text-center fw-bold\" *ngFor=\"let d of dayNames\">{{ d }}</div>\r\n                <ng-container *ngFor=\"let day of calendarDays\">\r\n                  <div *ngIf=\"day\" class=\"day-btn\" [class.active]=\"isSelected(day)\" [class.text-white]=\"isSelected(day)\"\r\n                    (click)=\"selectDate(day)\" style=\"cursor: pointer; padding: 6px;\">\r\n                    {{ day.getDate() }}\r\n                  </div>\r\n                  <div *ngIf=\"!day\" style=\"height: 34px;\"></div>\r\n                </ng-container>\r\n              </div>\r\n              <div class=\"moringa-btn-group footer align-right\">\r\n                <button class=\"moringa-btn\" (click)=\"cancel()\">Cancel</button>\r\n                <button class=\"moringa-btn primary\" (click)=\"confirm()\">Confirm</button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Header buttons -->\r\n          <div class=\"moringa-btn-group\">\r\n            <button *ngFor=\"let button of headerButtons\" type=\"button\" class=\"moringa-btn\" [id]=\"button.targetId\"\r\n              (click)=\"executeAction(button)\">\r\n              <i *ngIf=\"button.icon\" [class]=\"button.icon\"></i>\r\n              <span *ngIf=\"button.label\">{{ button.label }}</span>\r\n            </button>\r\n            <button *ngIf=\"collapsible\" class=\"moringa-btn\" type=\"button\" (click)=\"toggleCard()\">\r\n              <svg *ngIf=\"isCollapsed\" ...></svg>\r\n              <svg *ngIf=\"!isCollapsed\" ...></svg>\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Progress Bar -->\r\n    <div *ngIf=\"progressBy\" class=\"progress\">\r\n      <div class=\"progress-bar\"\r\n        [ngClass]=\"getStatusStyles(selectedOption || progressBy)?.progressClass || 'progress-bar-default'\"\r\n        role=\"progressbar\" [style.width.%]=\"progressValue\" [attr.aria-valuenow]=\"progressValue\" aria-valuemin=\"0\"\r\n        aria-valuemax=\"100\">\r\n        <p class=\"moringa-tag\">{{ progressValue }}%</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Table Body -->\r\n  <div class=\"moringa-body\">\r\n    <div class=\"table-wrapper\">\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th *ngFor=\"let column of columns; let colIndex = index\" (click)=\"Sorting ? sortByColumn(column.key) : null\"\r\n              class=\"text-nowrap text-start align-middle\" style=\"cursor: pointer;\" scope=\"col\">\r\n              <div class=\"sorting-group\">\r\n                <ng-container *ngIf=\"colIndex === 0\">\r\n                  <div class=\"checkbox-wrapper\">\r\n                    <input class=\"inp-cbx\" [id]=\"prefix + '-cbx-header'\" type=\"checkbox\"\r\n                      (click)=\"$event.stopPropagation()\" (change)=\"toggleAllRows($event)\" [checked]=\"isAllSelected()\" />\r\n                    <label class=\"cbx\" [for]=\"prefix + '-cbx-header'\">\r\n                      <div class=\"checkbox\"><svg width=\"12px\" height=\"10px\">\r\n                          <polyline points=\"1.5 6 4.5 9 10.5 1\"></polyline>\r\n                        </svg></div>\r\n                      <div *ngIf=\"selectedRows.length > 1\" class=\"moringa-dropdown\">\r\n                        <button class=\"moringa-btn no-bg\" (click)=\"toggleDropdown(-1, $event)\">\r\n                          <svg class=\"bi bi-three-dots-vertical\" ...></svg>\r\n                        </button>\r\n                        <ul class=\"dropdown-menu\" [class.show]=\"dropdownShownIndex === -1\">\r\n                          <li *ngFor=\"let btn of actionButtons\">\r\n                            <button class=\"dropdown-item\" (click)=\"handleBulkAction(btn)\">{{ btn.label }}</button>\r\n                          </li>\r\n                        </ul>\r\n                      </div>\r\n                    </label>\r\n                  </div>\r\n                </ng-container>\r\n                <span>{{ column.label }}</span>\r\n              </div>\r\n            </th>\r\n          </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n          <ng-container *ngIf=\"pagedData?.length\">\r\n            <ng-container *ngFor=\"let row of pagedData; let i = index; trackBy: trackByIndex\">\r\n              <tr *ngIf=\"row\" [ngClass]=\"{ 'dynamic-row': activeRowIndex === i }\">\r\n                <td *ngFor=\"let column of columns\">\r\n                  <ng-container [ngSwitch]=\"column.key\">\r\n\r\n                    <!-- ✅ mediaTile column -->\r\n                    <ng-container *ngSwitchCase=\"'mediaTile'\">\r\n                      <div class=\"moringa-group\">\r\n                        <div class=\"checkbox-wrapper\">\r\n                          <input class=\"inp-cbx\" [id]=\"prefix + '-cbx-' + i\" type=\"checkbox\"\r\n                            (change)=\"toggleSelectRow(row, $event)\" [checked]=\"selectedRows.includes(row)\" />\r\n                          <label class=\"cbx\" [for]=\"prefix + '-cbx-' + i\">\r\n                            <div class=\"checkbox\">\r\n                              <svg width=\"12px\" height=\"10px\" viewBox=\"0 0 12 10\">\r\n                                <polyline points=\"1.5 6 4.5 9 10.5 1\"></polyline>\r\n                              </svg>\r\n                            </div>\r\n                          </label>\r\n                        </div>\r\n\r\n                        <div class=\"media-tile\">\r\n                          <div class=\"media-img\" [ngClass]=\"statusMap?.[row.status] || 'default-status'\">\r\n                            <img *ngIf=\"row.mediaTile && !imageLoadFailedMap[row?.id || row?.[searchKey] || row?.name]\"\r\n                              class=\"img-fluid\" [src]=\"row.mediaTile || mediaImage\" alt=\"Media Image\"\r\n                              (error)=\"handleImageError($event, row)\" />\r\n                            <span *ngIf=\"!row.mediaTile || imageLoadFailedMap[row?.id || row?.[searchKey] || row?.name]\"\r\n                              class=\"letter-fallback\">\r\n                              {{ (row.name || '??').substring(0, 2