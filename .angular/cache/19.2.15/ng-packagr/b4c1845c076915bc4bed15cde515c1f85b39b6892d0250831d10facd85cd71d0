l>\r\n      </div>\r\n      <div class=\"matric-group gap\">\r\n        <ng-content select=\"[header-component]\"></ng-content>\r\n        <div class=\"matric-group gap\">\r\n          <div class=\"matric-btn-group \">\r\n            <ng-container>\r\n              <ng-container *ngIf=\"filterStyle.includes('dropdown')\">\r\n                <select class=\"matric-select\" [(ngModel)]=\"selectedOption\" (change)=\"applyFilters()\">\r\n                  <option value=\"\">All</option>\r\n                  <option *ngFor=\"let option of searchOptions\" [value]=\"option\">{{ option }}</option>\r\n                </select>\r\n              </ng-container>\r\n              <input type=\"text\" class=\"matric-input\" placeholder=\"Search...\" *ngIf=\"filterStyle.includes('keyword')\"\r\n                [(ngModel)]=\"searchKeyword\" (ngModelChange)=\"onSearchKeywordChange($event)\" />\r\n\r\n              <!-- Calendar Toggle Button -->\r\n              <button class=\"matric-btn\" *ngIf=\"filterStyle.includes('date')\" (click)=\"toggleCalendar()\"\r\n                style=\"min-width: 120px;\">\r\n                <svg fill=\"currentColor\" class=\"bi bi-calendar\" viewBox=\"0 0 16 16\" width=\"16\" height=\"16\"\r\n                  style=\"margin-right: 6px;\">\r\n                  <path\r\n                    d=\"M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z\" />\r\n                </svg>\r\n                <span>{{ selectedDate | date: 'y, MMMM, d' }}</span>\r\n              </button>\r\n\r\n              <!-- Calendar Popup -->\r\n              <div class=\"date-picker\" *ngIf=\"datePicker\" style=\"min-width: 350px;\">\r\n                <div class=\"matric-btn-group align-justify\">\r\n                  <select class=\"matric-select\" [(ngModel)]=\"selectedMonth\" (change)=\"onMonthOrYearChange()\">\r\n                    <option *ngFor=\"l