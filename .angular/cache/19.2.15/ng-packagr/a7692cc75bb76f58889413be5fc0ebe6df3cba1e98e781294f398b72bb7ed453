 option }}\r\n            </button>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n      <div class=\"matric-group gap\">\r\n        <ng-content select=\"[header-component]\"></ng-content>\r\n        <div class=\"matric-group gap\">\r\n          <div class=\"matric-btn-group \">\r\n\r\n            <ng-container>\r\n              <ng-container *ngIf=\"filterStyle.includes('dropdown')\">\r\n                <select class=\"matric-select\" [(ngModel)]=\"selectedOption\" (change)=\"applyFilters()\">\r\n                  <option value=\"\">All</option>\r\n                  <option *ngFor=\"let option of searchOptions\" [value]=\"option\">{{ option }}</option>\r\n                </select>\r\n              </ng-container>\r\n              <input type=\"text\" class=\"matric-input\" placeholder=\"Search...\" *ngIf=\"filterStyle.includes('keyword')\"\r\n                [(ngModel)]=\"searchKeyword\" (ngModelChange)=\"onSearchKeywordChange($event)\" />\r\n\r\n              <!-- Calendar Toggle Button -->\r\n              <button class=\"matric-btn\" *ngIf=\"filterStyle.includes('date')\" (click)=\"toggleCalendar()\"\r\n                style=\"min-width: 120px;\">\r\n                <svg fill=\"currentColor\" class=\"bi bi-calendar\" viewBox=\"0 0 16 16\" width=\"16\" height=\"16\"\r\n                  style=\"margin-right: 6px;\">\r\n                  <path\r\n                    d=\"M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z\" />\r\n                </svg>\r\n                <span>{{ selectedDate | date: 'y, MMMM, d' }}</span>\r\n              </button>\r\n\r\n              <!-- Calendar Popup -->\r\n              <div class=\"date-picker\" *ngIf=\"datePicker\" style=\"min-width: 350px;\">\r\n                <div class=\"matric-btn-group align-justify\">\r\n                  <select class=\"matric-select\" [(ngModel)]=\"selectedMonth\" (change)=\"onMonthOrYearChange()\">\r\n                    <option *ngFor=\"let m of months; let i = index\" [value]=\"i\">{{ m }}</option>\r\n                  </select>\r\n                  <select class=\"matric-select\" [(ngModel)]=\"selectedYear\" (change)=\"onMonthOrYearChange()\">\r\n                    <option *ngFor=\"let y of years\" [value]=\"y\">{{ y }}</option>\r\n                  </select>\r\n                </div>\r\n\r\n                <div class=\"d-grid\" style=\"grid-template-columns: repeat(7, 1fr); gap: 4px;\">\r\n                  <div class=\"text-center fw-bold\" *ngFor=\"let d of dayNames\">{{ d }}</div>\r\n\r\n                  <ng-container *ngFor=\"let day of calendarDays\">\r\n                    <div *ngIf=\"day\" class=\"day-btn\" [class.active]=\"isSelected(day)\"\r\n                      [class.text-white]=\"isSelected(day)\" (click)=\"selectDate(day)\"\r\n                      style=\"cursor: pointer; padding: 6px;\">\r\n                      {{ day.getDate() }}\r\n                    </div>\r\n                    <div *ngIf=\"!day\" style=\"height: 34px;\"></div>\r\n                  </ng-container>\r\n                </div>\r\n                <div class=\"matric-btn-group footer align-right\">\r\n                  <button class=\"matric-btn\" (click)=\"cancel()\">Cancel</button>\r\n                  <button class=\"matric-btn primary\" (click)=\"confirm()\">Confirm</button>\r\n                </div>\r\n              </div>\r\n            </ng-container>\r\n          </div>\r\n\r\n          <div class=\"matric-btn-group\">\r\n            <button *ngFor=\"let button of headerButtons\" type=\"button\" class=\"matric-btn \" [id]=\"button.targetId\"\r\n              (click)=\"executeAction(button)\">\r\n              <i *ngIf=\"button.icon\" [class]=\"button.icon\"></i>\r\n              <span *ngIf=\"button.label\">{{ button.label }}</span>\r\n            </button>\r\n\r\n            <button *ngIf=\"collapsible\" class=\"matric-btn \" type=\"button\" (click)=\"toggleCard()\">\r\n              <ng-container>\r\n                <svg *ngIf=\"isCollapsed\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\"\r\n                  viewBox=\"0 0 16 16\">\r\n                  <path fill-rule=\"evenodd\"\r\n                    d=\"M1 8a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13A.5.5 0 0 1 1 8M7.646.146a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 1.707V5.5a.5.5 0 0 1-1 0V1.707L6.354 2.854a.5.5 0 1 1-.708-.708zM8 10a.5.5 0 0 1 .5.5v3.793l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0 1-.708 0l-2-2a.5.5 0 0 1 .708-.708L7.5 14.293V10.5A.5.5 0 0 1 8 10\" />\r\n                </svg>\r\n\r\n                <svg *ngIf=\"!isCollapsed\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\"\r\n                  viewBox=\"0 0 16 16\">\r\n                  <path fill-rule=\"evenodd\"\r\n                    d=\"M1 8a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13A.5.5 0 0 1 1 8m7-8a.5.5 0 0 1 .5.5v3.793l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0 1-.708 0l-2-2a.5.5 0 1 1 .708-.708L7.5 4.293V.5A.5.5 0 0 1 8 0m-.5 11.707-1.146 1.147a.5.5 0 0 1-.708-.708l2-2a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 11.707V15.5a.5.5 0 0 1-1 0z\" />\r\n                </svg>\r\n              </ng-container>\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div *ngIf=\"progressBy\" class=\"progress\">\r\n      <div class=\"progress-bar\" [ngClass]=\"getStatusStyles(selectedOption || progressBy).progressClass\"\r\n        role=\"progressbar\" [style.width.%]=\"progressValue\" [attr.aria-valuenow]=\"progressValue\" aria-valuemin=\"0\"\r\n        aria-valuemax=\"100\">\r\n        <p class=\"matric-tag\">{{ progressValue }}%</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <div class=\"matric-body \">\r\n    <div class=\"table-wrapper\">\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th *ngFor=\"let column of colu