                            </button>\r\n                          </li>\r\n                        </ul>\r\n                      </div>\r\n\r\n                    </label>\r\n                  </div>\r\n                </ng-container>\r\n                <!-- Column Label -->\r\n                <span>{{ column.label }}</span>\r\n\r\n                <!-- Sort Icon -->\r\n                <ng-container *ngIf=\"Sorting\">\r\n                  <svg *ngIf=\"sortKey === column.key && sortAsc\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16\"\r\n                    height=\"16\" fill=\"currentColor\" viewBox=\"0 0 16 16\">\r\n                    <path fill-rule=\"evenodd\"\r\n                      d=\"M8 15a.5.5 0 0 0 .5-.5V2.707l3.146 3.147a.5.5 0 0 0 .708-.708l-4-4a.5.5 0 0 0-.708 0l-4 4a.5.5 0 1 0 .708.708L7.5 2.707V14.5a.5.5 0 0 0 .5.5\" />\r\n                  </svg>\r\n\r\n                  <svg *ngIf=\"sortKey === column.key && !sortAsc\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16\"\r\n                    height=\"16\" fill=\"currentColor\" viewBox=\"0 0 16 16\">\r\n                    <path fill-rule=\"evenodd\"\r\n                      d=\"M8 1a.5.5 0 0 1 .5.5v11.793l3.146-3.147a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .708-.708L7.5 13.293V1.5A.5.5 0 0 1 8 1\" />\r\n                  </svg>\r\n\r\n                  <svg *ngIf=\"sortKey !== column.key\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\"\r\n                    fill=\"currentColor\" viewBox=\"0 0 16 16\">\r\n                    <path fill-rule=\"evenodd\"\r\n                      d=\"M11.5 15a.5.5 0 0 0 .5-.5V2.707l3.146 3.147a.5.5 0 0 0 .708-.708l-4-4a.5.5 0 0 0-.708 0l-4 4a.5.5 0 1 0 .708.708L11 2.707V14.5a.5.5 0 0 0 .5.5m-7-14a.5.5 0 0 1 .5.5v11.793l3.146-3.147a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .708-.708L4 13.293V1.5a.5.5 0 0 1 .5-.5\" />\r\n                  </svg>\r\n                </ng-container>\r\n\r\n              </div>\r\n            </th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr *ngFor=\"let row of pagedData; let i = index; trackBy: trackByIndex\"\r\n            [ngClass]=\"{ 'dynamic-row': activeRowIndex === i }\">\r\n            <td *ngFor=\"let column of columns\">\r\n              <ng-container [ngSwitch]=\"column.key\">\r\n                <ng-container *ngSwitchCase=\"'mediaTile'\">\r\n                  <div class=\"matric-group\">\r\n                    <div class=\"checkbox-wrapper\">\r\n                      <input class=\"inp-cbx\" [id]=\"prefix + '-cbx-' + i\" type=\"checkbox\"\r\n                        (change)=\"toggleSelectRow(row, $event)\" [checked]=\"selectedRows.includes(row)\" />\r\n                      <label class=\"cbx\" [for]=\"prefix + '-cbx-' + i\">\r\n                        <div class=\"checkbox\">\r\n                          <svg width=\"12px\" height=\"10px\" viewBox=\"0 0 12 10\">\r\n                            <polyline points=\"1.5 6 4.5 9 10.5 1\"></polyline>\r\n                          </svg>\r\n                        </div>\r\n                        <p class=\"\"></p>\r\n                      </label>\r\n                    </div>\r\n                    <div class=\"media-tile\">\r\n                      <div class=\"media-img \" [ngClass]=\"statusMap[row.status]\">\r\n\r\n                        <!-- Show image only if not failed -->\r\n                        <img *ngIf=\"row.mediaTile && !imageLoadFailedMap[row?.id || row?.[searchKey] || row?.name]\"\r\n                          class=\"img-fluid\" [src]=\"row.mediaTile || mediaImage\" alt=\"Media Image\"\r\n                          (error)=\"handleImageError($event, row)\" />\r\n\r\n                        <!-- Show fallback name letters if image failed or missing -->\r\n                        <span *ngIf=\"!row.mediaTile || imageLoadFailedMap[row?.id || row?.[searchKey] || row?.name]\"\r\n                          class=\"letter-fallback\">\r\n              